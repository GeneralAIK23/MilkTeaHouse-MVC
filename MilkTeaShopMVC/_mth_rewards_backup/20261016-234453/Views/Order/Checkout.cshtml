@model MilkTeaShopMVC.Models.CheckoutViewModel
<link rel="stylesheet" href="@Url.Content("~/Content/mth-promotions.css")" />
@{ ViewBag.Title="Đặt hàng"; var total=Model.Items.Sum(x=>x.Subtotal); }
<section class="page container"><div class="eyebrow">CHỈ CÒN MỘT BƯỚC</div>
<h1>Hoàn tất <em>đặt hàng</em></h1><div class="cart-layout"><div class="panel formpanel">
<h2>Thông tin nhận hàng</h2>
@using(Html.BeginForm("Checkout","Order",FormMethod.Post)){
 @Html.AntiForgeryToken()
 @Html.ValidationSummary(false,"",new{@class="validation"})
 <label class="field-label">Họ và tên *</label>
 @Html.TextBoxFor(m=>m.CustomerName,new{@class="field",placeholder="Họ tên người nhận",maxlength="100",required="required"})
 <label class="field-label">Số điện thoại *</label>
 @Html.TextBoxFor(m=>m.Phone,new{@class="field",placeholder="09xxxxxxxx",maxlength="20",required="required"})
 <label class="field-label">Địa chỉ giao hàng *</label>
 @Html.TextBoxFor(m=>m.Address,new{@class="field",placeholder="Số nhà, đường, phường, quận...",maxlength="250",required="required"})
 <label class="field-label">Ghi chú</label>
 @Html.TextAreaFor(m=>m.Note,new{@class="field",rows="4",placeholder="Ít đá, ít đường...",maxlength="500"})
 <div class="mth-promo-apply">
 <label for="mth-promo-code">Mã giảm giá (nếu có)</label>
 <div class="mth-promo-apply-row">
  @Html.TextBoxFor(m=>m.PromoCode,new{@class="field",id="mth-promo-code",maxlength="40",placeholder="Nhập mã, ví dụ CHAO10"})
  <button type="button" id="mth-promo-check" data-url="@Url.Action("Preview","Promotions")">Kiểm tra mã</button>
 </div>
 <div class="mth-promo-status" id="mth-promo-status">Xem <a href="@Url.Action("Index","Promotions")" target="_blank" rel="noopener">các mã ưu đãi</a> đang áp dụng.</div>
</div>
<button class="btn primary wide" type="submit">Xác nhận đặt hàng →</button>
}
</div><aside class="panel summary"><h2>Đơn hàng của bạn</h2>
@foreach(var item in Model.Items){
 <div class="summary-line"><span>@item.Quantity × @item.ProductName (size @item.Size)
  @if(!string.IsNullOrWhiteSpace(item.ToppingSummary)){
   <small style="display:block">Topping: @item.ToppingSummary</small>
  }
 </span><b>@item.Subtotal.ToString("N0") ₫</b></div>
}
<hr/><div class="summary-line"><span>Tạm tính</span><b>@total.ToString("N0") ₫</b></div>
<div class="summary-line"><span>Khuyến mãi</span><b id="mth-promo-discount">0 đ</b></div>
<div class="summary-line grand"><span>Thành tiền</span><b class="mth-promo-total" id="mth-promo-grand" data-original="@total">@total.ToString("N0") đ</b></div>
<p class="sub">Thanh toán khi nhận hàng. Phí giao hàng chưa bao gồm và sẽ được xác nhận riêng.</p>
</aside></div></section>

<script src="@Url.Content("~/Scripts/mth-promotions.js")"></script>
