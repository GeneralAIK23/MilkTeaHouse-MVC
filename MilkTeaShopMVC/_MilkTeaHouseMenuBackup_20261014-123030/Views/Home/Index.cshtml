@model MilkTeaShopMVC.Models.ShopViewModel
@{ViewBag.Title="Trà sữa ngon mỗi ngày";}
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">● HƯƠNG VỊ CỦA NIỀM VUI</div><h1>Một chút ngọt ngào,<br/><em>cả ngày thêm vui.</em></h1><p>Khám phá bộ sưu tập trà sữa thơm béo, trà trái cây thanh mát và topping siêu mê. Làm mới ngày của bạn từ ngụm đầu tiên!</p><a class="btn primary" href="#menu">Khám phá thực đơn <span>↗</span></a><div class="hero-stats"><span><b>08+</b><small>Hương vị đặc sắc</small></span><span><b>100%</b><small>Niềm vui mỗi ngày</small></span><span><b>Fresh</b><small>Luôn tươi mới</small></span></div></div><div class="hero-art"><div class="decor decor-a">✦</div><div class="glass">🧋</div><div class="hero-sticker">MADE WITH<br/><b>LOVE ♥</b></div><div class="decor decor-b">✳</div></div></div></section>
<section class="features"><div class="container feature-grid"><div>🍃 <strong>Nguyên liệu tươi</strong><span>Hương vị chọn lọc</span></div><div>🥤 <strong>Đa dạng lựa chọn</strong><span>Size & topping tùy thích</span></div><div>💛 <strong>Đặt hàng dễ dàng</strong><span>Chỉ vài thao tác</span></div></div></section>
<section class="section container" id="menu"><div class="section-head"><div><div class="eyebrow">THỰC ĐƠN CỦA CHÚNG MÌNH</div><h2>Chọn món <em>bạn thích</em></h2><p>Mỗi ly trà là một trải nghiệm ngọt ngào.</p></div><span class="section-mark">SWEET & FRESH ✳</span></div>
<div class="filter-row"><a class="chip @(Model.CategoryId==null?"active":"")" href="@Url.Action("Index","Home",new{search=Model.Search})#menu">Tất cả</a>@foreach(var cat in Model.Categories){<a class="chip @(Model.CategoryId==cat.Id?"active":"")" href="@Url.Action("Index","Home",new{categoryId=cat.Id,search=Model.Search})#menu">@cat.Name</a>}
<form method="get" action="@Url.Action("Index","Home")" class="search"><input type="hidden" name="categoryId" value="@Model.CategoryId"/><input name="search" value="@Model.Search" placeholder="Tìm món trà yêu thích..." aria-label="Tìm sản phẩm"/><button type="submit">⌕</button></form></div>
@if(Model.Products.Any()){<div class="product-grid">@foreach(var product in Model.Products){@Html.Partial("~/Views/Shared/_Card.cshtml",product)}</div>}else{<div class="empty">Không tìm thấy món phù hợp. Hãy thử từ khóa khác nhé!</div>}
</section><section class="banner"><div class="container banner-flex"><div><div class="eyebrow">MILKTEA HOUSE</div><h2>Một chiếc trà ngon.<br/>Một ngày tuyệt vời.</h2><p>Thêm topping, chọn size, đặt ngay món yêu thích.</p></div><a class="btn light" href="@Url.Action("Index","Cart")">Xem giỏ hàng ↗</a></div></section>
