@model List<MilkTeaShopMVC.Models.ContactInboxItem>
@{ ViewBag.Title = "Tin nhắn liên hệ"; }
<section class="page container">
    <div class="eyebrow">MILKTEASHOP / QUẢN TRỊ</div>
    <h1>Tin nhắn liên hệ</h1>
    @Html.Partial("~/Views/Shared/_AdminNav.cshtml")
    <div class="panel inbox-panel">
        <div class="inbox-panel-head">
            <h2>Hộp thư khách hàng</h2>
            <span class="sub">@Model.Count tin nhắn gần nhất</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="empty">Chưa có tin nhắn liên hệ nào. Khi khách gửi form, nội dung sẽ xuất hiện ở đây.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="inbox-table">
                    <thead><tr><th>Trạng thái</th><th>Khách hàng</th><th>Email</th><th>Nội dung</th><th>Thời gian</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? "" : "inbox-unread")">
                            <td><span class="inbox-status @(item.IsRead ? "read" : "new")">@(item.IsRead ? "Đã đọc" : "Chưa đọc")</span></td>
                            <td><strong>@item.FullName</strong></td>
                            <td>@item.Email</td>
                            <td class="inbox-preview">@item.Summary</td>
                            <td>@item.CreatedAtLocal.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a href="@Url.Action("ContactDetail", "Admin", new { id = item.Id })">Xem chi tiết →</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
