@model MilkTeaShopMVC.Models.LoginViewModel
@{ViewBag.Title="Đăng nhập quản trị";}
<section class="page container"><div class="login-card panel"><div class="eyebrow">ADMIN PANEL</div><h1>Đăng nhập</h1><p>Quản lý cửa hàng MilkTea House.</p>@using(Html.BeginForm("Login","Admin",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label class="field-label">Email</label>@Html.TextBoxFor(m=>m.Email,new{@class="field",type="email",required="required"})<label class="field-label">Mật khẩu</label>@Html.PasswordFor(m=>m.Password,new{@class="field",required="required"})<button class="btn primary wide" type="submit">Đăng nhập</button>}<p class="sub">Tài khoản demo: admin@milktea.local / Demo@12345. Đổi mật khẩu trước khi đưa lên Internet.</p></div></section>
