@model List<MilkTeaShopMVC.Models.Order>
@{ViewBag.Title="Quản trị";}
<section class="page container"><div class="eyebrow">MILKTEA HOUSE</div><h1>Bảng điều khiển</h1>@Html.Partial("~/Views/Shared/_AdminNav.cshtml")<div class="metrics admin-inbox-metrics"><a class="metric franchise-dashboard-card" href="@Url.Action("FranchiseRequests","Admin")"><span>Yêu cầu nhượng quyền mới</span><b>@ViewBag.FranchiseNewCount</b></a><a class="metric contact-metric" href="@Url.Action("Contacts","Admin")"><span>Tin nhắn chưa đọc</span><b>@ViewBag.UnreadContactCount</b></a><div class="metric"><span>Sản phẩm đang bán</span><b>@ViewBag.ProductCount</b></div><div class="metric"><span>Tổng đơn hàng</span><b>@ViewBag.OrderCount</b></div><div class="metric"><span>Doanh thu chưa hủy</span><b>@(((decimal)ViewBag.Revenue).ToString("N0")) ₫</b></div></div><div class="panel"><h2>Đơn hàng gần đây</h2><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách</th><th>Ngày</th><th>Giá trị</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><a href="@Url.Action("OrderDetail","Admin",new{id=o.Id})">#@o.Id</a></td><td>@o.CustomerName</td><td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@o.Total.ToString("N0") ₫</td><td>@MilkTeaShopMVC.Models.MilkTeaStatusVi.Order(o.Status)</td></tr>}</tbody></table></div></div></section>
