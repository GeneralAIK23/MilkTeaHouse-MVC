@model MilkTeaShopMVC.Models.ContactInboxItem
@{ ViewBag.Title = "Nội dung liên hệ #" + Model.Id; }
<section class="page container">
    <div class="eyebrow">MILKTEASHOP / QUẢN TRỊ</div>
    <h1>Liên hệ #@Model.Id</h1>
    @Html.Partial("~/Views/Shared/_AdminNav.cshtml")
    <a class="back" href="@Url.Action("Contacts", "Admin")">← Quay lại hộp thư</a>
    <div class="panel inbox-detail">
        <div class="inbox-panel-head">
            <h2>Tin nhắn từ @Model.FullName</h2>
            <span class="inbox-status @(Model.IsRead ? "read" : "new")">@(Model.IsRead ? "Đã đọc" : "Chưa đọc")</span>
        </div>
        <dl class="inbox-facts">
            <dt>Họ tên</dt><dd>@Model.FullName</dd>
            <dt>Email</dt><dd>@Model.Email</dd>
            <dt>Số điện thoại</dt><dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cung cấp" : Model.Phone)</dd>
            <dt>Địa chỉ</dt><dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cung cấp" : Model.Address)</dd>
            <dt>Ngày gửi</dt><dd>@Model.CreatedAtLocal.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
        <h3>Nội dung khách gửi</h3>
        <div class="inbox-message">@Model.Message</div>
        @if (!Model.IsRead)
        {
            using (Html.BeginForm("MarkContactRead", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn primary">Đánh dấu đã đọc</button>
            }
        }
    </div>
</section>
