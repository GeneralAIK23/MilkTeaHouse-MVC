@model List<MilkTeaShopMVC.Models.Product>
@{ViewBag.Title="Quản lý sản phẩm";}
<section class="page container"><div class="eyebrow">ADMIN / PRODUCTS</div><h1>Quản lý sản phẩm</h1>@Html.Partial("~/Views/Shared/_AdminNav.cshtml")@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>}<p><a href="@Url.Action("Create","Admin")" class="btn primary">+ Thêm sản phẩm</a></p><div class="panel table-wrap"><table><thead><tr><th>ID</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Id</td><td>@p.Emoji @p.Name</td><td>@p.Category.Name</td><td>@p.Price.ToString("N0") ₫</td><td>@(p.IsAvailable?"Đang bán":"Đã ẩn")</td><td><a href="@Url.Action("Edit","Admin",new{id=p.Id})">Sửa</a> · @using(Html.BeginForm("Delete","Admin",FormMethod.Post,new{@class="inline-form"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="remove" type="submit" onclick="return confirm('Ẩn sản phẩm này?')">Ẩn</button>}</td></tr>}</tbody></table></div></section>
