@model List<MilkTeaShopMVC.Models.Order>
@{ViewBag.Title="Đơn hàng";}
<section class="page container"><div class="eyebrow">ADMIN / ORDERS</div><h1>Quản lý đơn hàng</h1>@Html.Partial("~/Views/Shared/_AdminNav.cshtml")<div class="panel table-wrap"><table><thead><tr><th>Mã</th><th>Khách hàng</th><th>Điện thoại</th><th>Thời gian</th><th>Tổng</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><a href="@Url.Action("OrderDetail","Admin",new{id=o.Id})">#@o.Id</a></td><td>@o.CustomerName</td><td>@o.Phone</td><td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@o.Total.ToString("N0") ₫</td><td>@MilkTeaShopMVC.Models.MilkTeaStatusVi.Order(o.Status)</td></tr>}</tbody></table></div></section>
