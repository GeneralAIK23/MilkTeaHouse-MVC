@model MilkTeaShopMVC.Models.Product
@{ViewBag.Title=Model.Id==0?"Thêm sản phẩm":"Sửa sản phẩm";}
<section class="page container"><div class="eyebrow">ADMIN / PRODUCT</div><h1>@ViewBag.Title</h1>@Html.Partial("~/Views/Shared/_AdminNav.cshtml")<div class="panel formpanel max-form">@using(Html.BeginForm("Save","Admin",FormMethod.Post)){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.Id)@Html.ValidationSummary(false,"",new{@class="validation"})<label class="field-label">Tên sản phẩm</label>@Html.TextBoxFor(m=>m.Name,new{@class="field",maxlength="120",required="required"})<label class="field-label">Mô tả</label>@Html.TextAreaFor(m=>m.Description,new{@class="field",rows="4",maxlength="700",required="required"})<label class="field-label">Giá (VND)</label>@Html.TextBoxFor(m=>m.Price,new{@class="field",type="number",min="1000",max="1000000",step="1000",required="required"})<label class="field-label">Danh mục</label>@Html.DropDownListFor(m=>m.CategoryId,(SelectList)ViewBag.Categories,"-- Chọn --",new{@class="field",required="required"})<label class="field-label">Emoji</label>@Html.TextBoxFor(m=>m.Emoji,new{@class="field",maxlength="30"})<label class="field-label">Màu nền (caramel/matcha/oolong/peach/lychee/lemon/cocoa)</label>@Html.TextBoxFor(m=>m.Theme,new{@class="field",maxlength="30"})<label class="checkbox-row">@Html.CheckBoxFor(m=>m.IsAvailable) Hiển thị sản phẩm</label><button class="btn primary" type="submit">Lưu sản phẩm</button>}</div></section>
