@model System.Collections.Generic.List<MilkTeaShopMVC.Models.LoyaltyPointTransaction>
@{ ViewBag.Title="Lịch sử điểm thưởng"; }
<link rel="stylesheet" href="@Url.Content("~/Content/mth-rewards.css")" />
<section class="page container mth-rewards-page">
 <div class="eyebrow">QUẢN TRỊ / MILKTEAHOUSE REWARDS</div>
 <h1>Giao dịch điểm thưởng</h1>
 @Html.Partial("~/Views/Shared/_AdminNav.cshtml")
 <p>Tổng điểm đã phát sinh do đơn hoàn thành: <strong>@ViewBag.PointsIssued điểm</strong>.</p>
 <p class="sub">Chỉ chọn trạng thái Hoàn thành sau khi đã xác nhận nhận tiền. Khi hủy đơn chưa thanh toán, điểm đã dùng được hoàn lại tự động.</p>
 <div class="table-wrap"><table class="mth-rewards-table"><thead><tr><th>Ngày</th><th>Khách ID</th><th>Đơn hàng</th><th>Loại</th><th>Điểm</th><th>Ghi chú</th></tr></thead><tbody>
 @foreach(var tx in Model){<tr><td>@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@tx.CustomerAccountId</td><td><a href="@Url.Action("OrderDetail","Admin",new{id=tx.OrderId})">#@tx.OrderId</a></td><td>@MilkTeaShopMVC.Models.MilkTeaStatusVi.PointType(tx.Type)</td><td class="@(tx.PointsDelta>0?"mth-positive":"mth-negative")">@(tx.PointsDelta>0?"+":"")@tx.PointsDelta</td><td>@tx.Description</td></tr>}
 @if(Model.Count==0){<tr><td colspan="6">Chưa có giao dịch điểm thưởng.</td></tr>}
 </tbody></table></div>
</section>
