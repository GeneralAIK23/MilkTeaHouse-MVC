@model MilkTeaShopMVC.Models.ShopViewModel
@{
    ViewBag.Title = "Thực đơn MilkTeaHouse";
}
<section class="mth-menu-head">
  <div class="container">
    <div class="mth-menu-crumb"><a href="@Url.Action("Index", "Home")">Trang chủ</a> / Thực đơn</div>
    <h1>Thực đơn MilkTeaHouse</h1>
    <p>Khám phá trà sữa, trà trái cây và các món đá xay. Chọn hương vị yêu thích, kích cỡ và topping phù hợp.</p>
  </div>
</section>
<section class="section container" id="menu"><div class="section-head"><div><div class="eyebrow">THỰC ĐƠN CỦA CHÚNG MÌNH</div><h2>Chọn món <em>bạn thích</em></h2><p>Mỗi ly trà là một trải nghiệm ngọt ngào.</p></div><span class="section-mark">SWEET & FRESH ✳</span></div>
<div class="filter-row"><a class="chip @(Model.CategoryId==null?"active":"")" href="@Url.Action("Index","Menu",new{search=Model.Search})#menu">Tất cả</a>@foreach(var cat in Model.Categories){<a class="chip @(Model.CategoryId==cat.Id?"active":"")" href="@Url.Action("Index","Menu",new{categoryId=cat.Id,search=Model.Search})#menu">@cat.Name</a>}
<form method="get" action="@Url.Action("Index","Menu")" class="search"><input type="hidden" name="categoryId" value="@Model.CategoryId"/><input name="search" value="@Model.Search" placeholder="Tìm món trà yêu thích..." aria-label="Tìm sản phẩm"/><button type="submit">⌕</button></form></div>
@if(Model.Products.Any()){<div class="product-grid">@foreach(var product in Model.Products){@Html.Partial("~/Views/Shared/_Card.cshtml",product)}</div>}else{<div class="empty">Không tìm thấy món phù hợp. Hãy thử từ khóa khác nhé!</div>}
</section>
