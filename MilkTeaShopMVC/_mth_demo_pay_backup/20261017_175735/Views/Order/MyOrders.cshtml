@model List<MilkTeaShopMVC.Models.Order>
@{ ViewBag.Title = "Đơn hàng của tôi"; }
<section class="page container">
  <div class="eyebrow">MILKTEASHOP / TÀI KHOẢN</div>
  <h1>Đơn hàng của tôi</h1>
  @if (Model.Count == 0) {
    <div class="panel"><p>Bạn chưa có đơn hàng nào từ tài khoản này.</p><a href="@Url.Action("Index", "Home")#menu">Khám phá thực đơn →</a></div>
  } else {
    <div class="panel table-wrap">
      <table>
        <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Giá trị</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var item in Model) {
          <tr><td>#@item.Id</td><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Total.ToString("N0") ₫</td><td>@MilkTeaShopMVC.Models.MilkTeaStatusVi.Order(item.Status)</td></tr>
        }
        </tbody>
      </table>
    </div>
  }
</section>
