@model MilkTeaShopMVC.Models.ProductDetailViewModel
@{ViewBag.Title=Model.Product.Name;}
<section class="page container"><a href="@Url.Action("Index","Home")#menu" class="back">← Quay lại thực đơn</a><div class="detail-grid"><div class="detail-art @Model.Product.Theme" style="position:relative;overflow:hidden;padding:0;">
    @if (!string.IsNullOrWhiteSpace(Model.Product.ImageUrl))
    {
        <img src="@Url.Content("~" + Model.Product.ImageUrl)"
             alt="@Model.Product.Name"
             class="detail-product-image"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />
    }
    else
    {
        <span>@Model.Product.Emoji</span>
        <div>FRESHLY BREWED · WITH LOVE</div>
    }
</div><div class="detail-text"><div class="eyebrow">MILKTEA HOUSE / CHỌN MÓN</div><h1>@Model.Product.Name</h1><p>@Model.Product.Description</p><div class="price-big">@Model.Product.Price.ToString("N0") ₫ <small>giá size M, chưa gồm topping</small></div>
@using(Html.BeginForm("Add","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Product.Id"/>
<label class="field-label">Chọn size</label><div class="size-row"><label><input type="radio" name="size" value="M" checked/> <span>Size M <small>Giá gốc</small></span></label><label><input type="radio" name="size" value="L"/> <span>Size L <small>+ 7.000 ₫</small></span></label></div>
<label class="field-label" for="topping">Thêm topping</label><select id="topping" class="field" name="toppingId"><option value="">Không topping</option>@foreach(var t in Model.Toppings){<option value="@t.Id">@t.Name (+@t.Price.ToString("N0") ₫)</option>}</select>
<label class="field-label" for="quantity">Số lượng</label><input class="field smallfield" id="quantity" type="number" min="1" max="30" name="quantity" value="1" required/><button type="submit" class="btn primary wide">🛒 Thêm vào giỏ hàng</button>}
</div></div></section>
