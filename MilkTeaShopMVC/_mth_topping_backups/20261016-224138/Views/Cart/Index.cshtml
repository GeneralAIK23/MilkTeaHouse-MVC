@model List<MilkTeaShopMVC.Models.CartLine>
@{ViewBag.Title="Giỏ hàng";var total=Model.Sum(x=>x.Subtotal);}
<section class="page container"><div class="eyebrow">ĐƠN HÀNG CỦA BẠN</div><h1>Giỏ hàng <em>ngọt ngào</em></h1>@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>}
@if(!Model.Any()){<div class="empty">🛒 Giỏ hàng đang trống.<br/><a class="btn primary" href="@Url.Action("Index","Home")#menu">Chọn món ngay</a></div>}else{<div class="cart-layout"><div class="panel">@foreach(var x in Model){<div class="cart-row"><div class="cart-emoji">@x.Emoji</div><div class="cart-name"><h3>@x.ProductName</h3><div class="sub">Size @x.Size @(string.IsNullOrEmpty(x.ToppingName)?"":" · "+x.ToppingName)</div><b>@x.UnitPrice.ToString("N0") ₫ / ly</b></div><div class="cart-action">@using(Html.BeginForm("Update","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="key" value="@x.Key"/><input type="number" min="0" max="30" name="quantity" value="@x.Quantity" class="qty"/><button class="tiny" type="submit">Cập nhật</button>}@using(Html.BeginForm("Remove","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="key" value="@x.Key"/><button class="remove" type="submit">Xóa</button>}</div></div>}</div><aside class="panel summary"><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính</span><b>@total.ToString("N0") ₫</b></div><div class="summary-line"><span>Phí vận chuyển</span><span>Chưa tính</span></div><hr/><div class="summary-line grand"><span>Tổng cộng</span><b>@total.ToString("N0") ₫</b></div><a class="btn primary wide" href="@Url.Action("Checkout","Order")">Tiến hành đặt hàng →</a><a class="text-link" href="@Url.Action("Index","Home")#menu">← Tiếp tục mua sắm</a></aside></div>}</section>
